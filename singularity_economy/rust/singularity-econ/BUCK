# Buck2 targets. Third-party-free by design: the "serde" cargo feature is
# off here, so everything builds with rustc alone. The dependency-full paths
# (CLI, snapshot regression vs goldens, proptest) run under cargo — see
# ../../BUILDING.md.

SRCS = glob([
    "src/lib.rs",
    "src/valuation.rs",
    "src/scenarios.rs",
    "src/companies.rs",
    "src/society.rs",
    "src/demography.rs",
    "src/space.rs",
    "src/geopolitics.rs",
    "src/macrofin.rs",
    "src/bio.rs",
])

rust_library(
    name = "core",
    srcs = SRCS,
    crate = "singularity_econ",
    crate_root = "src/lib.rs",
    edition = "2021",
    visibility = ["PUBLIC"],
)

rust_test(
    name = "core_test",
    srcs = SRCS,
    crate = "singularity_econ_test",
    crate_root = "src/lib.rs",
    edition = "2021",
)

rust_test(
    name = "behavior",
    srcs = ["tests/behavior.rs"],
    crate_root = "tests/behavior.rs",
    edition = "2021",
    deps = [":core"],
)

